// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ProfileUpdateNameSuccess Component > matches snapshot 1`] = `
<div>
  <gcds-container>
    <gcds-notice>
      <gcds-text>
        <strong>
          Your name has been updated to
           
          Test User
        </strong>
      </gcds-text>
    </gcds-notice>
    <gcds-heading>
      You may need to update your name in other places.
    </gcds-heading>
    <gcds-heading>
      This only changes your name with services connected to your GC Sign in.
    </gcds-heading>
    <gcds-text>
      If you are trying to update your name with a service that’s not connected to your GC Sign in, you’ll need to go to that account.
    </gcds-text>
    <gcds-text>
      To search for another GC Account, visit the 
       
      <gcds-link>
        GC Account directory.
      </gcds-link>
    </gcds-text>
    <gcds-text>
      To view what services are connected to your GC Sign in, go to 
       
      <gcds-link>
        Connected Services 
      </gcds-link>
      in your GC Sign in dashboard.
    </gcds-text>
    <gcds-grid
      align-items="center"
    >
      <gcds-button
        style="width: fit-content;"
      >
        Back to profile
      </gcds-button>
       
      <gcds-button
        style="width: fit-content;"
      >
        Sign out
      </gcds-button>
    </gcds-grid>
  </gcds-container>
</div>
`;
