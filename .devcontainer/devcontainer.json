{
	"name": "gcsignin-devcontainer",
	"image": "mcr.microsoft.com/devcontainers/go:bullseye@sha256:6afc6554abe4fca8ec6b2f504774e19b5e9db18c45ea1d2c23a083e57ed638a6",
	"containerEnv": {
		"SHELL": "/bin/zsh"
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.13",
			"installTools": "false"
		},
		"ghcr.io/devcontainers/features/terraform:1": {
			"version": "1.9.4",
			"terragrunt": "0.66.9"
		},
		"ghcr.io/dhoeric/features/terraform-docs:1": {
			"version": "0.19.0"
		},
		"node": {
			"version": "lts",
			"nodeGypDependencies": true
		},
		"ghcr.io/devcontainers/features/aws-cli:1": {
			"version": "latest"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"GitHub.copilot",
				"hashicorp.terraform",
				"redhat.vscode-yaml",
				"ms-python.python",
				"ms-python.debugpy",
				"hashicorp.hcl",
				"mermaidchart.vscode-mermaid-chart",
				"eamodio.gitlens"
			],
			"settings": {
				"[terraform]": {
					"editor.formatOnSave": true
				}
			}
		}
	}
}