                      "        console.log(\"Saved ASSERTION_JWT to environment\");",
                      "    } else {",
                      "        console.warn(\"Could not find a JWT/assertion field in the response - inspect the response body and set ASSERTION_JWT manually\");",
                      "    }",
                      "}"
                    ]
                  }
                }
