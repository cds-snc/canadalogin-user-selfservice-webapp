            {
              "name": "Get User Access Token",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    if (body.access_token) {",
                      "        pm.environment.set(\"USER_ACCESS_TOKEN\", body.access_token);",
                      "        console.log(\"Saved USER_ACCESS_TOKEN to environment\");",
                      "    }",
                      "    if (body.refresh_token) {",
                      "        pm.environment.set(\"REFRESH_TOKEN\", body.refresh_token);",
                      "        console.log(\"Saved REFRESH_TOKEN to environment\");",
                      "    }",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{ADMIN_ACCESS_TOKEN}}",
                      "type": "string"
