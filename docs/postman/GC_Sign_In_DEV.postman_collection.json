                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    const body = pm.response.json();",
                      "    const jwt = body.jwt || body.token || body.assertion;",
                      "    if (jwt) {",
                      "        pm.environment.set(\"ASSERTION_JWT\", jwt);",
                      "        console.log(\"Saved ASSERTION_JWT to environment\");",
                      "    } else {",
                      "        console.warn(\"Could not find a JWT/assertion field in the response - inspect the response body and set ASSERTION_JWT manually\");",
                      "    }",
                      "}"
                    ]
                  }
                }
