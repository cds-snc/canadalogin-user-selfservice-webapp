{
  "info": {
    "_postman_id": "b3f6e6f0-1c2a-4e3a-9d3b-idv-data-store-exchange",
    "name": "IDV Data Store - Token Exchange Flow",
    "description": "Standalone collection mirroring the RFC 8693 OAuth 2.0 Token Exchange + in-person verification logic in backend/app/idv_data_store/services/in_person_verification.py. Requires a USER_ACCESS_TOKEN obtained separately (e.g. from the GC_Sign_In_DEV collection's 'Get User Access Token' request). See README.md in this folder for setup steps and environment variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Exchange User Token for IDV Data Store (STS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    if (body.access_token) {",
              "        pm.environment.set(\"IDV_EXCHANGED_ACCESS_TOKEN\", body.access_token);",
              "        console.log(\"Saved IDV_EXCHANGED_ACCESS_TOKEN to environment\");",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "urn:ietf:params:oauth:grant-type:token-exchange",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{IDV_DATA_STORE_STS_CLIENT_ID}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{IDV_DATA_STORE_STS_CLIENT_SECRET}}",
              "type": "text"
            },
            {
              "key": "subject_token",
              "value": "{{USER_ACCESS_TOKEN}}",
              "type": "text"
            },
            {
              "key": "subject_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "requested_token_type",
              "value": "urn:ietf:params:oauth:token-type:access_token",
              "type": "text"
            },
            {
              "key": "scope",
              "value": "{{IDV_DATA_STORE_USERINFO_SCOPE}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{IBM_VERIFY_TENANT_URL}}/oauth2/token",
          "host": ["{{IBM_VERIFY_TENANT_URL}}"],
          "path": ["oauth2", "token"]
        },
        "description": "RFC 8693 OAuth 2.0 Token Exchange reference flow for idv-data-store /v1/auth/userinfo. Uses the dedicated IBM Verify STS client credentials to exchange USER_ACCESS_TOKEN for a delegated token scoped to idv-data-store userinfo access. Saves access_token to IDV_EXCHANGED_ACCESS_TOKEN."
      },
      "response": []
    },
    {
      "name": "1. Get Userinfo Claims",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{IDV_EXCHANGED_ACCESS_TOKEN}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{IDV_DATA_STORE_BASE_URL}}/v1/auth/userinfo",
          "host": ["{{IDV_DATA_STORE_BASE_URL}}"],
          "path": ["v1", "auth", "userinfo"]
        },
        "description": "Calls idv-data-store POST /v1/auth/userinfo as the reference delegated-token flow. Uses IDV_EXCHANGED_ACCESS_TOKEN directly as Bearer auth; no request-body access_token and no idv-data-store bootstrap token are required."
      },
      "response": []
    }
  ]
}
