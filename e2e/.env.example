# Copy to e2e/.env for local runs. Never commit real credentials.

# Self-service frontend and backend under test.
# E2E_API_URL must match the VITE_BACKEND_API_URL the frontend was built with.
# IDV routes are only enabled when the frontend runs with VITE_ENVIRONMENT=dev or test.
E2E_BASE_URL=https://local.dev.login-connexion.alpha.canada.ca:3000
E2E_API_URL=https://local.dev.login-connexion.alpha.canada.ca:8000
# Set to true for self-signed local certificates.
E2E_IGNORE_HTTPS_ERRORS=false
# Browser timezone, also used to compute expected dates.
E2E_TIMEZONE=America/Toronto

# User A: has completed fake ID proofing.
# *_ID is the IBM Verify user id (sub).
E2E_PROVEN_USER_EMAIL=
E2E_PROVEN_USER_PASSWORD=

# User B: has no ID proofing data.
E2E_UNPROVEN_USER_EMAIL=
E2E_UNPROVEN_USER_PASSWORD=

# In Person Service Canada test user
E2E_IN_PERSON_USER_EMAIL=
E2E_IN_PERSON_USER_PASSWORD=

# In Person Canada Post test user
E2E_IN_PERSON_CANADA_POST_USER_EMAIL=
E2E_IN_PERSON_CANADA_POST_USER_PASSWORD=