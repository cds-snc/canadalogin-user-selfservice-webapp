{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Test Explorer (Debug Test)",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend",
        "PYTEST_ADDOPTS": "-s --no-cov"
      },
      "envFile": "${workspaceFolder}/backend/tests/.env"
    },
    {
      "name": "Python Debugger: FastAPI (HTTPS)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "redis: start (selfservice)",
      "postDebugTask": "redis: stop (selfservice)",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--reload-dir",
        "backend/tests",
        "--reload-exclude",
        ".venv/*",
        "--reload-exclude",
        "**/site-packages/*",
        "--port",
        "8000",
        "--host",
        "0.0.0.0",
        "--ssl-keyfile=backend/certs/key.pem",
        "--ssl-certfile=backend/certs/cert.pem"
      ],
      "env": {
        "PYTHONPATH": "backend"
      },
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "name": "Python Debugger: FastAPI (HTTP)",
      "type": "debugpy",
      "request": "launch",
      "preLaunchTask": "redis: start (selfservice)",
      "postDebugTask": "redis: stop (selfservice)",
      "python": "${command:python.interpreterPath}",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--app-dir",
        "backend",
        "--reload",
        "--reload-dir",
        "backend/app",
        "--reload-dir",
        "backend/tests",
        "--reload-exclude",
        ".venv/*",
        "--reload-exclude",
        "**/site-packages/*",
        "--port",
        "8000",
        "--host",
        "127.0.0.1"
      ],
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "name": "React Debugger",
      "request": "launch",
      "type": "chrome",
      "url": "https://app.cds-gcsignin-dev.verify.ibm.com:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "React Debugger (localhost)",
      "request": "launch",
      "type": "chrome",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Python Debugger: Current Test File",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/tests/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    },
    {
      "name": "Python Debugger: All Tests",
      "type": "debugpy",
      "request": "launch",
      "python": "${command:python.interpreterPath}",
      "module": "pytest",
      "args": ["backend/tests/", "-v"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/backend/tests/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      }
    }
  ]
}
