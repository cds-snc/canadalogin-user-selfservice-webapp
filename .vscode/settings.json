{
  "plantuml.exportOutDir": ".",
  // Prevent the "Commit (No Verify)" shortcut from appearing in the Source Control panel,
  // ensuring black, flake8, and prettier always run via the .githooks/pre-commit hook.
  "git.allowNoVerifyCommit": false,
  // Python interpreter — use the repo's virtual environment
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // Test Explorer: use pytest, run from repo root so pytest.ini is picked up
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [],
  "python.testing.cwd": "${workspaceFolder}",
  "python-envs.defaultEnvManager": "ms-python.python:system"
}
